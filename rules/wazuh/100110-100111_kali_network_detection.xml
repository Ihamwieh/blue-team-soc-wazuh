<group name="windows,windows_security,network_scan,">
  <rule id="100110" level="5">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^5156$</field>
    <field name="win.eventdata.sourceAddress">^192\.168\.20\.7$</field>
    <description>Kali network connection detected: $(win.eventdata.sourceAddress) to $(win.eventdata.destAddress):$(win.eventdata.destPort)</description>
    <group>network_scan,kali_activity,</group>
  </rule>

  <rule id="100111" level="10" frequency="10" timeframe="60" ignore="60">
    <if_matched_sid>100110</if_matched_sid>
    <same_field>win.eventdata.sourceAddress</same_field>
    <description>Possible Kali network scan: 10 or more connections within 60 seconds</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>network_scan,kali_activity,correlation,</group>
  </rule>
</group>
